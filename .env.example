# ============================================================
#  IELTS Speaking AI — Environment variables
#  Copy this file to ".env" and fill in your values.
# ============================================================

# --- AI provider (REQUIRED for real AI) ----------------------
# Works with any OpenAI-compatible chat API.
# Examples:
#   OpenAI        : https://api.openai.com/v1
#   Groq          : https://api.groq.com/openai/v1
#   OpenRouter    : https://openrouter.ai/api/v1
#   Together AI   : https://api.together.xyz/v1
#   Ollama (local): http://localhost:11434/v1
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# The model name to use. Examples:
#   OpenAI:   gpt-4o-mini  (cheap + fast, recommended)  or  gpt-4o
#   Groq:     llama-3.3-70b-versatile
#   OpenRouter: openai/gpt-4o-mini
#   Ollama:   llama3.2
LLM_MODEL=gpt-4o-mini

# Speech-to-text model (for microphone recording). Used by /api/transcribe.
# On OpenRouter, e.g. openai/whisper-large-v3 or openai/whisper-1.
LLM_STT_MODEL=openai/whisper-large-v3

# --- Demo mode (optional) ------------------------------------
# If no OPENAI_API_KEY is set, the app automatically runs in
# DEMO mode so you can still test the whole flow (voice, transcript,
# analysis, PDF) with canned responses. Set to true to force it.
DEMO_MODE=false

# --- Server ---------------------------------------------------
# Port the backend listens on (default 8000)
PORT=8000
